{
  "manifest_version": 3,
  "name": "Afterburner",
  "version": "1.0",
  "description": "Removes the 16-character limit on Basecamp boost messages",
  "content_scripts": [
    {
      "matches": ["https://*.basecamp.com/*", "http://*.basecamp.localhost:*/*", "https://*.bc4-beta.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
